{
	"name": "@mmmike/extra-drizzle-kit",
	"version": "1.0.0",
	"description": "Indexes on materialized views, and migrations that recreate the views that depend on a changed one, for drizzle-kit generate on Postgres.",
	"keywords": [
		"drizzle",
		"drizzle-kit",
		"drizzle-orm",
		"postgres",
		"postgresql",
		"materialized-view",
		"migrations",
		"index"
	],
	"homepage": "https://github.com/MMMikeM/extra-drizzle-kit#readme",
	"bugs": {
		"url": "https://github.com/MMMikeM/extra-drizzle-kit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MMMikeM/extra-drizzle-kit.git"
	},
	"license": "MIT",
	"author": "Mike Murray",
	"type": "module",
	"files": [
		"dist"
	],
	"sideEffects": false,
	"bin": {
		"extra-drizzle-kit": "./dist/cli.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"lint:types": "tsc -p tsconfig.json && tsc -p tsconfig.check.json",
		"test": "vp test run",
		"test:unit": "vp test run test/unit",
		"check": "pnpm run lint:types && pnpm run test",
		"prepublishOnly": "pnpm run check && pnpm run build"
	},
	"peerDependencies": {
		"drizzle-kit": "1.0.0-rc.5",
		"drizzle-orm": "1.0.0-rc.5"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "0.18.5",
		"@testcontainers/postgresql": "^12.2.1",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "1.0.0-rc.5",
		"drizzle-orm": "1.0.0-rc.5",
		"pg": "^8.23.1",
		"publint": "0.3.25",
		"typescript": "^7.0.2",
		"vite-plus": "1.4.0"
	},
	"engines": {
		"node": ">=24"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.15.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.15.0"
}
